# TFM ESP32 RNG campaign -- build defaults
CONFIG_IDF_TARGET="esp32"

# 115200 baud: the only rate the classic ESP32 console emitted reliably on
# the CP2102 bridge used in this campaign (460800/921600 produced no app
# output). 1 Mbit hex frames stream in ~22 s per condition.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# ERROR-only logging: WiFi driver INFO logs interleave with the hex frame
# stream and corrupt captures.
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_LOG_DEFAULT_LEVEL=1
CONFIG_LOG_MAXIMUM_LEVEL=1

# 240 MHz for consistent throughput measurements
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
