# Compilados de simulacion y sintesis (se regeneran con rtl/run_tb.py y synth/sintetiza.py)
rtl/build/
synth/build/
# Firmware: el build de ESP-IDF se regenera con idf.py build
firmware/*/build/
firmware/*/sdkconfig
firmware/*/sdkconfig.old
firmware/*/dependencies.lock
firmware/*/managed_components/
# Memoria: solo fuentes, no el PDF ni auxiliares
memoria/*.aux
memoria/*.log
memoria/*.out
memoria/*.toc
memoria/*.lof
memoria/*.lot
memoria/*.bbl
memoria/*.blg
memoria/*.acn
memoria/*.acr
memoria/*.alg
memoria/*.synctex.gz
# Python
__pycache__/
*.pyc
# Copias de seguridad y temporales
*.bak
*~
# Derivados de las capturas (se regeneran con analysis/entropia_90b.py)
results/entropia90b/bits/
# Logs serie integros de las capturas del ESP32: se guardan en local (evidencia) pero no se versionan;
# la carga util con CRC comprobado va en results/esp32_tramas_*.bin
results/esp32_consola_*.log
# Copia por consola de esos mismos logs (stdout de consola_esp32.py): tampoco se versiona
results/esp32_captura_*.txt
